# Required — your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional shared secret: when set, every API call must send `X-API-Key: <value>`.
# Leave empty to disable (only do that behind a firewall).
API_KEY=

# Server
HOST=0.0.0.0
PORT=8000

# Storage root for work/, output/ and jobs/ state (./data works locally;
# docker-compose overrides with /data/instagram-groq inside the container)
WORK_DIR=./data

# Chunking — the pipeline ALWAYS splits; a reel under this stays one chunk
CHUNK_SECONDS=900        # 15 min chunks
OVERLAP_SECONDS=2        # overlap so words are never cut at chunk boundaries

# Groq
GROQ_MODEL=whisper-large-v3
MAX_WORKERS=5            # concurrent chunk uploads
GROQ_TIMEOUT=300

# Language — ISO-639-1 code for transcription (en, ar, fr, es, etc.)
# Empty = auto-detect by Whisper. Ignored when TRANSLATE_TO_EN=true.
DEFAULT_LANG=

# Translation — when true, uses Groq's /audio/translations endpoint
# to translate any language to English automatically
TRANSLATE_TO_EN=false

# Callback
CALLBACK_TIMEOUT=10